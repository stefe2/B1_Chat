<Window x:Class="b1_chat_console.SceneNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PageBackgroundBrush}"
        Icon="Assets/AppIcon.ico"
        ContentRendered="Window_ContentRendered">
    <Border Style="{StaticResource CardBorderStyle}" Margin="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="SAVE SCENE AS" Style="{StaticResource CardTitleStyle}" Margin="0" />
            <TextBlock Grid.Row="1" Text="Choose a unique name for this Scene."
                       Style="{StaticResource MetaTextStyle}" Margin="0,4,0,14" />
            <StackPanel Grid.Row="2">
                <TextBlock Text="SCENE NAME" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,5" />
                <TextBox x:Name="NameBox" Text="{Binding SceneName}" MaxLength="128"
                         Style="{StaticResource RecessedTextBoxStyle}" Padding="9,7" />
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" Style="{StaticResource MiniButtonStyle}"
                        IsCancel="True" MinWidth="82" Margin="0,0,8,0" />
                <Button Content="Save" Style="{StaticResource AccentButtonStyle}"
                        IsDefault="True" MinWidth="82" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
