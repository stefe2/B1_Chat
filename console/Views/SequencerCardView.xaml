<UserControl x:Class="b1_chat_console.Views.SequencerCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:b1_chat_console.Views"
             PreviewKeyDown="SequencerCardView_PreviewKeyDown">
    <Border Style="{StaticResource CardBorderStyle}">
        <StackPanel>
            <DockPanel LastChildFill="False" Margin="0,0,0,12">
                <Border Style="{StaticResource CardIconBoxStyle}" DockPanel.Dock="Left" Margin="0,0,10,0">
                    <Canvas Width="15" Height="15">
                        <Rectangle Canvas.Left="0" Canvas.Top="1" Width="10" Height="2.6" RadiusX="1.3" RadiusY="1.3" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.3" />
                        <Rectangle Canvas.Left="0" Canvas.Top="6" Width="15" Height="2.6" RadiusX="1.3" RadiusY="1.3" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.3" />
                        <Rectangle Canvas.Left="0" Canvas.Top="11" Width="7" Height="2.6" RadiusX="1.3" RadiusY="1.3" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.3" />
                    </Canvas>
                </Border>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="ANIMATION SEQUENCER" Style="{StaticResource CardTitleStyle}" FontSize="13" Margin="0" />
                    <TextBlock Text="Multi-track timeline — parallel per-droid lanes, absolute start times"
                               Style="{StaticResource MetaTextStyle}" Margin="0,1,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource ValuePillStyle}" VerticalAlignment="Center" MinWidth="0">
                    <TextBlock Text="{Binding SequenceBadgeText}" Style="{StaticResource ValuePillTextStyle}" FontSize="10.5" />
                </Border>
            </DockPanel>

            <!-- Conventional document bar: the Local Library is an implementation detail
                 behind Open, not a permanently exposed list below the editor. -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="SCENE" Style="{StaticResource SectionSubtitleStyle}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="SceneNameBox" Grid.Column="1" Text="{Binding EditableName}" MaxLength="128"
                         Style="{StaticResource RecessedTextBoxStyle}" IsEnabled="{Binding CanEditSequence}"
                         ToolTip="Editable Scene name. Changes participate in Undo/Redo and mark the Scene as modified."
                         ToolTipService.ShowOnDisabled="True" Margin="0,0,8,0" />
                <Border Grid.Column="2" Style="{StaticResource ValuePillStyle}" Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding SceneDocumentStateText}" Style="{StaticResource ValuePillTextStyle}"
                               FontSize="9.5" />
                </Border>
                <Button Grid.Column="3" Content="New" Style="{StaticResource MiniButtonStyle}"
                        Command="{Binding NewSceneCommand}" Margin="0,0,4,0"
                        ToolTip="Create a new empty Scene (Ctrl+N). Unsaved changes and active playback are handled explicitly." />
                <Button Grid.Column="4" Content="Open…" Style="{StaticResource MiniButtonStyle}"
                        Command="{Binding OpenSceneLibraryCommand}" Margin="0,0,4,0"
                        ToolTip="Open the Scene browser (Ctrl+O)." />
                <Button Grid.Column="5" Content="Save" Style="{StaticResource MiniButtonStyle}"
                        Command="{Binding SaveSceneCommand}" Margin="0,0,4,0"
                        ToolTip="Save changes to the current Local Library Scene. For a new or imported document, this creates a new stable Scene identity. Stop playback first."
                        ToolTipService.ShowOnDisabled="True" />
                <Button x:Name="SceneMoreButton" Grid.Column="6" Content="⋯" Style="{StaticResource MiniButtonStyle}"
                        MinWidth="31" Click="SceneMoreButton_Click" ToolTip="More Scene actions.">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource DarkContextMenuStyle}"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Save As…" Style="{StaticResource DarkMenuItemStyle}"
                                      Command="{Binding SaveSceneAsCommand}" InputGestureText="Ctrl+Shift+S"
                                      ToolTip="Create a separate Local Library Scene. Stop playback first." />
                            <MenuItem Header="Rename" Style="{StaticResource DarkMenuItemStyle}"
                                      IsEnabled="{Binding CanEditSequence}" Click="RenameSceneMenuItem_Click" InputGestureText="F2"
                                      ToolTip="Edit the current Scene name. Stop playback first." />
                            <Separator Margin="4,2" Background="{StaticResource BorderLoBrush}" />
                            <MenuItem Header="Import from file…" Style="{StaticResource DarkMenuItemStyle}"
                                      Command="{Binding ImportCommand}"
                                      ToolTip="Validate and open a .b1scene.json file. Active playback must be stopped before replacement." />
                            <MenuItem Header="Export a copy…" Style="{StaticResource DarkMenuItemStyle}"
                                      Command="{Binding ExportCommand}"
                                      ToolTip="Write an external JSON snapshot. Linked audio files are not copied." />
                            <Separator Margin="4,2" Background="{StaticResource BorderLoBrush}" />
                            <MenuItem Header="Move current Scene to Trash…" Style="{StaticResource DarkMenuItemStyle}"
                                      Command="{Binding DeleteCurrentSceneCommand}"
                                      ToolTip="Move the current Local Library entry to recoverable trash. Stop playback first." />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>

            <views:SequenceTimelineView />
        </StackPanel>
    </Border>
</UserControl>
