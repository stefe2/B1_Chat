<Window x:Class="b1_chat_console.SceneDecisionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PageBackgroundBrush}"
        Icon="Assets/AppIcon.ico">
    <Border Style="{StaticResource CardBorderStyle}" Margin="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding Heading}" Style="{StaticResource CardTitleStyle}" Margin="0" />
            <TextBlock Grid.Row="1" Text="{Binding Message}" Foreground="{StaticResource TextBrush}"
                       TextWrapping="Wrap" Margin="0,12,0,18" FontSize="12" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding SecondaryLabel}" Style="{StaticResource MiniButtonStyle}"
                        Visibility="{Binding ShowSecondary, Converter={StaticResource BoolToVisConv}}"
                        Click="Secondary_Click" Margin="0,0,8,0" MinWidth="130"
                        ToolTip="Choose the secondary action shown on this button and continue." />
                <Button Content="Cancel" Style="{StaticResource MiniButtonStyle}"
                        IsCancel="True" Margin="0,0,8,0" MinWidth="82"
                        ToolTip="Cancel this operation and leave the current state unchanged." />
                <Button Content="{Binding PrimaryLabel}" Style="{StaticResource AccentButtonStyle}"
                        IsDefault="True" Click="Primary_Click" MinWidth="130"
                        ToolTip="Choose the primary action shown on this button and continue." />
            </StackPanel>
        </Grid>
    </Border>
</Window>
